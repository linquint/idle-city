{
  "name": "idle-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An idle city builder where every purchase is a building and the world expands district by district.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:citygen",
    "test:watch": "vitest",
    "test:citygen": "node --check src/sim/citygen.ts && node --check tools/citygen.test.mjs && node tools/citygen.test.mjs",
    "model:parts": "node tools/model2parts.mjs",
    "citygen:calibrate": "node tools/citygen.calibrate.mjs",
    "parcels:calibrate": "node tools/parcels.calibrate.mjs",
    "economy:calibrate": "node tools/economy.calibrate.mjs",
    "water:calibrate": "node tools/water.calibrate.mjs",
    "estates:calibrate": "node tools/estates.calibrate.mjs",
    "upkeep:calibrate": "node tools/upkeep.calibrate.mjs",
    "landvalue:calibrate": "node tools/landvalue.calibrate.mjs",
    "power:calibrate": "node tools/power.calibrate.mjs",
    "traffic:calibrate": "node tools/traffic.calibrate.mjs",
    "education:calibrate": "node tools/education.calibrate.mjs",
    "ranks:calibrate": "node tools/ranks.calibrate.mjs",
    "ascension:calibrate": "node tools/ascension.calibrate.mjs",
    "crime:calibrate": "node tools/crime.calibrate.mjs",
    "garbage:calibrate": "node tools/garbage.calibrate.mjs",
    "rival:calibrate": "node tools/rival.calibrate.mjs",
    "pedestrians:calibrate": "node --experimental-transform-types tools/pedestrians.calibrate.mjs",
    "lod:calibrate": "node --experimental-transform-types tools/lod.calibrate.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
